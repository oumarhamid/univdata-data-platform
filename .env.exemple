# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# PostgreSQL (utilisé par Hive, Metabase, Airflow)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# Airflow (UID utilisateur)
AIRFLOW_UID=50000

# Autres (optionnels)
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_RAW_HTML=raw-web-html
MINIO_BUCKET_RAW_DOCS=raw-documents
MINIO_BUCKET_RAW_IMAGES=raw-images
MINIO_BUCKET_RAW_JSON=raw-json
MINIO_BUCKET_RAW_LOGS=raw-logs