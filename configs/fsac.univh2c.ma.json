{
    "domain": "fsac.univh2c.ma",
    "start_url": "https://fsac.univh2c.ma/front/index.html",
    "seed_urls": [
        "https://fsac.univh2c.ma/front/tabs.html?page=departements",
        "https://fsac.univh2c.ma/front/tabs.html?page=formations",
        "https://fsac.univh2c.ma/front/tabs.html?page=presentation"
