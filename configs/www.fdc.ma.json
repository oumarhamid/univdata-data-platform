{
    "domain": "www.fdc.ma",
    "start_url": "https://www.fdc.ma/FDC/",
    "max_depth": 3,
    "rate_limit_seconds": 2,
    "respect_robots": true,
    "user_agent": "UnivDataBot/1.0 (+https://univdata.com/bot)",
    "buckets": {
        "html": "raw-web-html",
        "documents": "raw-documents",
        "images": "raw-images",
        "logs": "raw-logs"
    },
    "file_extensions": [
        "pdf",
        "doc",
        "docx",
        "xls",
        "xlsx",
        "ppt",
        "pptx",
        "odt",
        "ods",
        "csv",
        "json",
        "xml",
        "zip",
        "rar"
    ],
    "image_extensions": [
        "jpg",
        "jpeg",
        "png",
        "gif",
        "svg",
        "webp",
        "bmp",
        "ico"
    ],
    "max_pages_per_domain": 100,
    "use_playwright": true,
    "seed_urls": []
}