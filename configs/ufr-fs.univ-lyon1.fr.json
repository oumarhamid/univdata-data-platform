{
    "domain": "ufr-fs.univ-lyon1.fr",
    "start_url": "http://ufr-fs.univ-lyon1.fr/",
    "max_depth": 3,
    "rate_limit_seconds": 1,
    "respect_robots": true,
    "user_agent": "UnivDataBot/1.0 (+https://univdata.com/bot)",
    "buckets": {
        "html": "raw-web-html",
        "documents": "raw-documents",
        "images": "raw-images",
        "logs": "raw-logs"
    },
    "file_extensions": [
        "pdf",
        "doc",
        "docx",
        "xls",
        "xlsx",
        "ppt",
        "pptx",
        "odt",
        "ods",
        "csv",
        "json",
        "xml",
        "zip"
    ],
    "image_extensions": [
        "jpg",
        "jpeg",
        "png",
        "gif",
        "svg",
        "webp",
        "bmp"
    ],
    "max_pages_per_domain": 200,
    "use_playwright": false,
    "seed_urls": [
        "http://ufr-fs.univ-lyon1.fr/departements",
        "http://ufr-fs.univ-lyon1.fr/annuaire",
        "http://ufr-fs.univ-lyon1.fr/recherche"
    ]
}